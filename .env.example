# Port used by the Fastify API server (defaults to 4000 if not set)
API_PORT=4000

# Optional fallback for the API port in some deployment environments
PORT=4000

# PostgreSQL connection string for production (preferred)
# Example: postgresql://user:password@host:5432/infidash?sslmode=disable
DATABASE_URL=

# Optional SSL mode for the PostgreSQL client (e.g. disable, require)
DATABASE_SSL=disable

# Production bootstrap only: used to create the first admin if no admin exists.
# Use a secret manager or local ignored .env; minimum 12 characters. Does not
# reset or replace credentials for accounts already stored in the database.
INFIDASH_ADMIN_EMAIL=
INFIDASH_ADMIN_PASSWORD=

# Opt in only after disposable-DB and staging validation: closes due KPI cycles
# at 00:00 Europe/Madrid on day 25, catching up after downtime.
# INFIDASH_MONTHLY_AUTO_CLOSE=1

# Optional production viewer bootstrap. No default viewer is created in production.
# INFIDASH_VIEWER_EMAIL=
# INFIDASH_VIEWER_PASSWORD=

# Async editorial pool (optional tuning)
EDITORIAL_DB_POOL_MAX=10
EDITORIAL_DB_IDLE_TIMEOUT_MS=30000
EDITORIAL_DB_CONNECTION_TIMEOUT_MS=5000
EDITORIAL_DB_APPLICATION_NAME=infidash-editorial

# n8n uses INFIDASH_INTERNAL_API_URL and INFIDASH_SERVICE_TOKEN in its own
# runtime. Do not add the plain service token to the Infidash environment.

# Optional directory for database backups
INFIDASH_BACKUP_DIR=/data/backups

# Optional frontend/runtime settings
APP_URL=http://127.0.0.1:3000

# Saved PDF report delivery. Port 465 uses implicit TLS; other ports require STARTTLS.
REPORT_SMTP_HOST=
REPORT_SMTP_PORT=587
REPORT_SMTP_USER=
REPORT_SMTP_PASSWORD=
REPORT_SMTP_FROM=


# Google Analytics 4 (GA4): single shared service-account credential used for
# every client's GA4 property. Paste the full downloaded service-account key
# JSON as one line here; the \n sequences inside private_key survive
# JSON.parse as real newlines, no extra handling needed. Each client only
# configures their own numeric GA4 Property ID in the integration itself
# (not a secret) -- the service account's email (shown in Integraciones once
# this is set) must be granted Viewer access on that property in GA4.
GA4_SERVICE_ACCOUNT_JSON=

# Google Ads: single shared manager-account (MCC) credential used for every
# client's Google Ads account, mirroring the GA4 pattern above. Each client
# only configures their own numeric Customer ID in the integration itself
# (not a secret) -- that Customer ID must be linked under this same MCC.
# GOOGLE_ADS_REFRESH_TOKEN is obtained once via a manual interactive OAuth
# flow outside Infidash (e.g. Google's OAuth Playground, authenticating as a
# user with access to the MCC) -- unlike GA4, this manual step cannot be
# avoided, but it only needs to be done once for the whole agency.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
