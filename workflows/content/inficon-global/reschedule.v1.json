      "parameters": {
        "jsCode": "const job=$('Validar trabajo').first().json.job;const ctx=$('Cargar contexto Infidash').first().json;const requested=job.payload.publication;const account=(ctx.accounts??[]).find(x=>x.id===requested.accountId&&x.provider==='postiz'&&x.active!==false);if(!account)throw new Error('Cuenta Postiz no autorizada para el cliente');if(!requested.copy)throw new Error('La publicacion requiere copy');let generatedImagePath=null;try{generatedImagePath=$('Subir imagen a Postiz').first().json.path??null;}catch(e){generatedImagePath=null;}const imageUrl=requested.media?.[0]?.url??generatedImagePath??ctx.settings?.editorial_config?.fallbackImageUrl;if(!imageUrl)throw new Error('La publicacion requiere imagen o editorial_config.fallbackImageUrl');const instanceKey=String(account.instance_key||'').toLowerCase();let postizSettings;if(instanceKey.includes('facebook')){postizSettings=[{key:'__type',stringValue:'facebook'}];}else if(instanceKey.includes('instagram')){postizSettings=[{key:'post_type',stringValue:'post'}];}else if(instanceKey.includes('gmb')||instanceKey.includes('business')||instanceKey.includes('google')){const ctaUrl=requested.externalUrl||ctx.settings?.editorial_config?.site_url||'';if(!ctaUrl)throw new Error('La publicacion en GMB requiere una URL (externalUrl del job o editorial_config.site_url)');postizSettings=[{key:'topicType',stringValue:'STANDARD'},{key:'callToActionType',stringValue:'LEARN_MORE'},{key:'callToActionUrl',stringValue:ctaUrl}];}else{postizSettings=[];}const oldPostizPostId=requested.postizPostId?String(requested.postizPostId):null;return [{json:{integrationId:account.external_account_id,accountId:account.id,desiredScheduledAt:requested.desiredScheduledAt,copy:requested.copy,externalUrl:requested.externalUrl??'',imageUrl,postizInstance:account.instance_key,postizSettings,oldPostizPostId}}];"
      },
