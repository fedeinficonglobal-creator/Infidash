        "jsCode": "const job=$('Validar trabajo').first().json.job;const req=$('Preparar reprogramacion').first().json;const response=$('Postiz1').first().json;const postId=response.postId??response.id;if(!postId)throw new Error('Postiz no devolvio postId');const publication={status:'scheduled',confirmedScheduledAt:req.desiredScheduledAt,postizPostId:String(postId),providerPostId:null,externalUrl:null,publishedAt:null,errorCode:null,errorMessage:null};const event={schemaVersion:1,clientId:job.client_id,entityType:'publication',entityId:job.target_id,eventType:'postiz.rescheduled',sourceEventId:`postiz:${req.postizInstance}:${postId}:rescheduled`,occurredAt:new Date().toISOString(),publicationStatus:'scheduled',payload:{accountId:req.accountId,postizPostId:String(postId),oldPostizPostId:req.oldPostizPostId,confirmedScheduledAt:req.desiredScheduledAt}};return [{json:{schemaVersion:1,clientId:job.client_id,status:'succeeded',publication,event,result:{workflowVersion:1,state:'scheduled'},leaseToken:job.leaseToken,jobId:job.id}}];"
