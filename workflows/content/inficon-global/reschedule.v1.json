        "jsCode": "const job=$('Validar trabajo').first().json.job;const ctx=$('Cargar contexto Infidash').first().json;const requested=job.payload.publication;const account=(ctx.accounts??[]).find(x=>x.id===requested.accountId&&x.provider==='postiz'&&x.active!==false);if(!account)throw new Error('Cuenta Postiz no autorizada para el cliente');if(!requested.copy)throw new Error('La publicacion requiere copy');const isHttpUrl=(value)=>typeof value==='string'&&/^https?:\\/\\//i.test(value.trim());let media=(Array.isArray(requested.media)?requested.media:[]).filter(item=>item&&isHttpUrl(item.url)).slice(0,10).map(item=>{const entry={url:item.url.trim()};if(item.type==='image'||item.type==='video')entry.type=item.type;if(item.name)entry.name=String(item.name);return entry;});if(!media.length){let generatedImagePath=null;try{generatedImagePath=$('Subir imagen a Postiz').first().json.path??null;}catch(e){generatedImagePath=null;}const fallbackUrl=generatedImagePath??ctx.settings?.editorial_config?.fallbackImageUrl;if(fallbackUrl)media=[{url:String(fallbackUrl),type:'image'}];}if(!media.length)throw new Error('La publicacion requiere imagen o editorial_config.fallbackImageUrl');const imageUrl=media[0].url;const instanceKey=String(account.instance_key||'').toLowerCase();let network;if(instanceKey.includes('facebook'))network='facebook';else if(instanceKey.includes('instagram'))network='instagram';else if(instanceKey.includes('gmb')||instanceKey.includes('business')||instanceKey.includes('google'))network='gmb';else network='other';let externalUrl=String(requested.externalUrl??'').trim();if(network==='gmb'){externalUrl=externalUrl||ctx.settings?.editorial_config?.site_url||'';if(!externalUrl)throw new Error('La publicacion en GMB requiere una URL (externalUrl del job o editorial_config.site_url)');}const oldPostizPostId=requested.postizPostId?String(requested.postizPostId):null;return [{json:{integrationId:account.external_account_id,accountId:account.id,desiredScheduledAt:re