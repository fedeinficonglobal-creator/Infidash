      "parameters": {
        "jsCode": "const job=$('Validar trabajo').first().json.job;const req=$('Preparar reprogramacion').first().json;const err=$('Postiz1').first().json;const raw=err.error??err;const statusCode=Number(raw.httpCode??raw.statusCode??raw.status??0);const confirmed=statusCode>=400&&statusCode<500&&statusCode!==408&&statusCode!==409&&statusCode!==429;const state=confirmed?'failed':'unknown';const message=String(raw.message??raw.description??'Resultado ambiguo de Postiz al reprogramar').slice(0,4000);const publication={status:state,confirmedScheduledAt:null,postizPostId:null,providerPostId:null,externalUrl:null,publishedAt:null,errorCode:statusCode?String(statusCode):(confirmed?'POSTIZ_REJECTED':'POSTIZ_AMBIGUOUS'),errorMessage:message};const event={schemaVersion:1,clientId:job.client_id,entityType:'publication',entityId:job.target_id,eventType:confirmed?'postiz.reschedule_rejected':'postiz.reschedule_ambiguous',sourceEventId:`postiz-reschedule-attempt:${req.postizInstance}:${job.id}`,occurredAt:new Date().toISOString(),publicationStatus:state,payload:{accountId:req.accountId,oldPostizPostId:req.oldPostizPostId,statusCode:statusCode||null,errorMessage:message,reconcileRequired:!confirmed}};return [{json:{schemaVersion:1,clientId:job.client_id,status:state,publication,event,result:{workflowVersion:1,reconcileRequired:!confirmed},error:message,leaseToken:job.leaseToken,jobId:job.id}}];"
