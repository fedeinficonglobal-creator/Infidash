    {
      "parameters": {
        "jsCode": "const job=$('Validar trabajo').first().json.job;const ctx=$input.first().json;const requested=job.payload.publication;const account=(ctx.accounts??[]).find(x=>x.id===requested.accountId&&x.provider==='postiz'&&x.active!==false);if(!account)throw new Error('Cuenta Postiz no autorizada para el cliente');if(!requested.copy)throw new Error('La publicacion requiere copy');const imageUrl=requested.media?.[0]?.url??ctx.settings?.editorial_config?.fallbackImageUrl;if(!imageUrl)throw new Error('La publicacion requiere imagen o editorial_config.fallbackImageUrl');return [{json:{integrationId:account.external_account_id,accountId:account.id,desiredScheduledAt:requested.desiredScheduledAt,copy:requested.copy,externalUrl:requested.externalUrl??'',imageUrl,postizInstance:account.instance_key}}];"
      },
      "id": "prepare-publish-v1",
      "name": "Preparar publicacion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        0
      ]
    },
    {
      "parameters": {
        "type": "schedule",
        "date": "={{ $('Preparar publicacion').first().json.desiredScheduledAt }}",
        "posts": {
          "post": [
            {
              "integrationId": "={{ $('Preparar publicacion').first().json.integrationId }}",
              "settings": {
                "setting": [
                  {
                    "key": "topicType",
                    "stringValue": "STANDARD"
                  },
                  {
                    "key": "callToActionType",
                    "stringValue": "LEARN_MORE"
                  },
                  {
                    "key": "callToActionUrl",
                    "stringValue": "={{ $('Preparar publicacion').first().json.externalUrl }}"
                  }
                ]
              },
              "value": {
                "contentItem": [
                  {
                    "content": "={{ $('Preparar publicacion').first().json.copy }}",
                    "id": "={{ $('Validar trabajo').first().json.job.target_id }}",
                    "image": {
                      "imageItem": [
                        {
                          "id": "img1",
                          "path": "={{ $('Preparar publicacion').first().json.imageUrl }}"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
