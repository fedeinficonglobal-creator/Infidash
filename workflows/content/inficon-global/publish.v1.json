    {
      "parameters": {
        "jsCode": "const input=$input.first().json;const job=input.job??input;if(job.kind!=='publish'||!job.id||!job.client_id||!job.target_id||!job.leaseToken)throw new Error('Contrato publish v1 invalido');const pub=job.payload?.publication;if(!pub?.desiredScheduledAt||Number.isNaN(Date.parse(pub.desiredScheduledAt)))throw new Error('desiredScheduledAt ISO-8601 es obligatorio');return [{json:{job}}];"
      },
