{
  "name": "Content v1 - Dispatcher",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "schedule-dispatcher-v1",
      "name": "Cada minuto",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        -720,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { executionId: String($execution.id), leaseSeconds: 1800 } }];"
      },
      "id": "execution-dispatcher-v1",
      "name": "Preparar reserva",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.INFIDASH_INTERNAL_API_URL + '/api/internal/content/jobs/claim' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.INFIDASH_SERVICE_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ executionId: $json.executionId, leaseSeconds: $json.leaseSeconds }) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "claim-dispatcher-v1",
      "name": "Reservar siguiente trabajo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ !!$json.job }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-dispatcher-v1",
      "name": "Hay trabajo",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.INFIDASH_INTERNAL_API_URL + '/api/internal/content/clients/' + $json.job.client_id + '/context' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.INFIDASH_SERVICE_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "context-dispatcher-v1",
      "name": "Cargar binding del cliente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        -80
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const job = $('Interpretar reserva').first().json.job;\nconst context = $input.first().json;\nconst workflowId = context.settings?.workflow_bindings?.[job.kind];\nif (!workflowId || typeof workflowId !== 'string') throw new Error(`No hay workflow binding para ${job.kind} y ${job.client_id}`);\nreturn [{ json: { job, workflowId } }];"
      },
      "id": "binding-dispatcher-v1",
      "name": "Resolver workflow autorizado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        -80
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "={{ $json.workflowId }}",
          "mode": "id"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "execute-dispatcher-v1",
      "name": "Ejecutar workflow del cliente",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1040,
        -80
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.INFIDASH_INTERNAL_API_URL + '/api/internal/content/jobs/' + $json.job.id + '/heartbeat' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.INFIDASH_SERVICE_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({clientId:$json.job.client_id,leaseToken:$json.job.leaseToken,leaseSeconds:1800}) }}",
        "options": {}
      },
      "id": "heartbeat-dispatcher-v1",
      "name": "Renovar lease antes de ejecutar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        -80
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "return [{json:$('Resolver workflow autorizado').first().json}];"
      },
      "id": "restore-dispatcher-v1",
      "name": "Restaurar trabajo reservado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        820,
        -80
      ]
    },
    {
      "parameters": {
        "jsCode": "const response=$input.first()?.json??{};const status=Number(response.statusCode??0);if(status===204)return [];let body=response.body;if(typeof body==='string'&&body.trim()){try{body=JSON.parse(body);}catch(e){}}if(status===200&&body&&typeof body==='object'&&body.job)return [{json:{job:body.job}}];const detail=typeof body==='string'?body:JSON.stringify(body??response.error??null);throw new Error(`Reserva de trabajo fallida (HTTP ${status||'sin respuesta'}): ${String(detail).slice(0,500)}`);"
      },
      "id": "a2b56a4e-70c4-4230-86f3-3b79d36a8f8d",
      "name": "Interpretar reserva",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -120,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const job=$('Interpretar reserva').first().json.job;const failure=$input.first()?.json??{};const raw=failure.error??failure;const detail=typeof raw==='string'?raw:(raw?.message??raw?.description??failure.message);const error=String(detail??'Fallo en el dispatcher').slice(0,4000);return [{json:{jobId:job.id,body:{schemaVersion:1,clientId:job.client_id,status:'failed',error,result:{workflowVersion:1,stage:'dispatcher'},leaseToken:job.leaseToken}}}];"
      },
      "id": "dda59d98-6e69-4b95-ba84-faf8fff8fcd3",
      "name": "Preparar fallo dispatcher",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        240
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.INFIDASH_INTERNAL_API_URL + '/api/internal/content/jobs/' + $json.jobId + '/result' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.INFIDASH_SERVICE_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json.body) }}",
        "options": {}
      },
      "id": "9a5cb60e-9e84-41d9-9c68-4dfdd55a3841",
      "name": "Guardar fallo dispatcher",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        940,
        240
      ]
    }
  ],
  "connections": {
