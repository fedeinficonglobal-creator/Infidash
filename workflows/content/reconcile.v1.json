    {
      "parameters": {
        "jsCode": "const job=$('Validar trabajo').first().json.job;const req=$('Preparar consulta Postiz').first().json;const err=$('Consultar publicaciones Postiz').first().json;const message=String(err.error?.message??err.message??'No se pudo confirmar el estado en Postiz').slice(0,4000);const publication={status:'unknown',postizPostId:req.postizPostId,errorCode:'POSTIZ_RECONCILE_UNAVAILABLE',errorMessage:message};const event={schemaVersion:1,clientId:job.client_id,entityType:'publication',entityId:job.target_id,eventType:'postiz.reconcile_unavailable',sourceEventId:`postiz-reconcile-error:${job.id}`,occurredAt:new Date().toISOString(),publicationStatus:'unknown',payload:{accountId:req.accountId,errorMessage:message}};return [{json:{schemaVersion:1,clientId:job.client_id,status:'unknown',publication,event,result:{workflowVersion:1,reconciled:false},error:message,leaseToken:job.leaseToken,jobId:job.id}}];"
      },
